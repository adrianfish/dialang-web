{
  "name": "dialang-web",
  "type": "module",
  "scripts": {
    "test": "vitest --exclude e2e-tests",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "e2e-tests": "playwright test --headed",
    "tail": "wrangler tail dialang --format=pretty",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/actors": "^0.0.1-beta.6",
    "hono": "^4.13.13",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "vitest": "5.0.5",
    "wrangler": "^4.151.1"
  }
}
