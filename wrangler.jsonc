{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dialang",
	"main": "main.ts",
	"compatibility_date": "2026-10-06",
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION",
				"class_name": "SessionDO"
			}
		]
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./static"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "dialang",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "DIALANG_DATA",
			"id": "0ca6c8e775f140c781d9568472526b47"
		}
	],
	"d1_databases": [
		{
			"binding": "DIALANG_RESULTS",
			"database_name": "dialang-results",
			"migrations_dir": "migrations",
			"database_id": "e94addf1-2c44-4d29-9d9d-88bd47fbb728"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"exports": {
		"SessionDO": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}